---
import App from '../../layouts/App.astro';
import Designer from '../../components/designer/Designer.astro';
import { liveSource } from '../../data/api/live';
import { flowsFrom } from '../../data/flows/index';

// Rendered on each request, so the canvas always shows what the flow API returns right now.
export const prerender = false;

const flows = flowsFrom(await liveSource());
const flow = flows.find((f) => f.id === Astro.params.flow);
if (!flow) return Astro.redirect('/designer/inquiry/');
Astro.response.headers.set('Cache-Control', 'no-store');
---

<App title={`Designer · ${flow.name}`} description={flow.summary} app>
  <Designer flow={flow} flows={flows} />
</App>
