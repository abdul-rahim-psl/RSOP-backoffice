---
import App from '../layouts/App.astro';
import Loading from '../components/Loading.astro';
import DashboardBody from '../components/dashboard/DashboardBody.astro';
import { pktLongDay } from '../lib/format';

// The page arrives at once with a loader; both logs are read on the server meanwhile and the figures replace it.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<App title="Dashboard" description="Bill-pay activity for the RSOP back office, counted live from the bill inquiry and payment logs.">
  <DashboardBody server:defer>
    <Loading
      slot="fallback"
      title="Dashboard"
      lede={`Bill inquiries and payments for ${pktLongDay(new Date())}, counted from the logs.`}
      reading="the bill inquiry and payment logs"
    />
  </DashboardBody>
</App>

<script>
  import '../scripts/charts';
</script>
