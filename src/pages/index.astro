---
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { safeNext } from '../lib/session';

// The screen asked for before signing in, so the form can go back to it.
const next = safeNext(Astro.url.searchParams.get('next'));
---

<Base title="Sign in" description="Sign in to the RSOP back office.">
  <div class="signin">
    <div class="top">
      <ThemeToggle />
    </div>

    <main class="center">
      <section class="card" aria-labelledby="signin-h">
        <div class="brand-row">
          <Brand href="/" size="lg" />
          <p class="platform">Raast Service Orchestration Platform</p>
        </div>
        <h1 id="signin-h">Sign in</h1>
        <!-- No name attributes on the inputs: what is typed here is never sent, only where to go next. -->
        <form class="form" action="/signin" method="post" data-signin>
          <input type="hidden" name="next" value={next} />
          <label class="field">
            <span>Username</span>
            <input class="input" type="text" autocomplete="username" required />
          </label>
          <label class="field">
            <span>Password</span>
            <input class="input" type="password" autocomplete="current-password" required />
          </label>
          <button class="btn primary wide" type="submit">Sign in</button>
        </form>
      </section>
      <p class="legal">© 2026 RSOP · Back Office</p>
    </main>
  </div>
</Base>

<style>
  .signin {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100dvh;
    padding: 12px 16px 32px;
  }

  .top {
    display: flex;
    justify-content: flex-end;
  }

  .center {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 16px;
    padding-bottom: 6vh;
  }

  .card {
    display: grid;
    gap: 24px;
    width: min(100%, 400px);
    padding: 32px;
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--card-shadow);
  }

  .brand-row {
    display: grid;
    gap: 6px;
  }

  .platform {
    color: var(--mut);
    font-size: 0.8125rem;
  }

  h1 {
    color: var(--ink-2);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .form {
    display: grid;
    gap: 16px;
  }

  .wide {
    width: 100%;
    margin-top: 8px;
  }

  .legal {
    color: var(--mut);
    font-size: 0.75rem;
  }

  @media (max-width: 480px) {
    .card {
      padding: 24px 20px;
    }
  }
</style>
