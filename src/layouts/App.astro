---
import Base from './Base.astro';
import AppHeader from '../components/AppHeader.astro';

interface Props {
  title: string;
  description?: string;
  /** The Designer fills the viewport like a desktop app and has no page footer. */
  app?: boolean;
}

const { title, description, app = false } = Astro.props;
---

<Base title={title} description={description} bodyClass={app ? 'app' : undefined}>
  <AppHeader />
  {
    app ? (
      <main id="main">
        <slot />
      </main>
    ) : (
      <main class="page" id="main">
        <slot />
      </main>
    )
  }
</Base>
