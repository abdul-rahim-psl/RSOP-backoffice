---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Extra class on <body>, for pages that size themselves to the viewport. */
  bodyClass?: string;
}

const site = 'Backoffice';
const { title, description = 'The RSOP back office: dashboard, bill logs, flow designer and users.', bodyClass } = Astro.props;
const pageTitle = title ? `${site} · ${title}` : site;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Runs before first paint, so a saved dark theme never flashes light first,
      // and so CSS can hide the no-JavaScript fallbacks before they are ever seen.
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('rsop-ui-theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
    <title>{pageTitle}</title>
    <meta name="application-name" content={site} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/72-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/72-Bold.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
