---
import Brand from './Brand.astro';
import Icon, { type IconName } from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { can, INQUIRY_LOG, initials, me, PAYMENT_LOG } from '../data/users';

const path = Astro.url.pathname;
const links: { href: string; match: string; label: string; icon: IconName }[] = [
  { href: '/dashboard/', match: '/dashboard', label: 'Dashboard', icon: 'dashboard' },
  ...(can(me.role, INQUIRY_LOG) ? [{ href: '/inquiries/', match: '/inquiries', label: 'Inquiries', icon: 'inbound' as const }] : []),
  ...(can(me.role, PAYMENT_LOG) ? [{ href: '/payments/', match: '/payments', label: 'Payments', icon: 'outbound' as const }] : []),
  { href: '/designer/inquiry/', match: '/designer', label: 'Designer', icon: 'designer' },
  { href: '/users/', match: '/users', label: 'Users', icon: 'users' },
];
const current = (match: string) => (path.startsWith(match) ? 'page' : undefined);
---

<header class="app-header">
  <Brand />

  <nav class="nav" aria-label="Back office">
    {
      links.map((l) => (
        <a href={l.href} aria-current={current(l.match)}>
          <Icon name={l.icon} size={16} />
          {l.label}
        </a>
      ))
    }
  </nav>

  <div class="tools">
    <ThemeToggle />
    <form class="out" action="/logout" method="post">
      <button class="btn out-btn" type="submit" aria-label="Log out">
        <Icon name="logout" size={16} />
        <span class="out-word">Log out</span>
      </button>
    </form>
    <button class="me" type="button" popovertarget="me-menu" aria-label={`${me.name}, account menu`}>
      <span aria-hidden="true">{initials(me.name)}</span>
    </button>
    <button class="menu-btn" type="button" popovertarget="nav-menu" aria-label="Menu">
      <Icon name="menu" size={18} />
    </button>
  </div>
</header>

<div id="me-menu" class="pop glass" popover>
  <p class="who">{me.name}</p>
  <p class="mail">{me.email}</p>
  <p class="role"><span class="pill" data-tone="info">{me.role}</span></p>
  <form action="/logout" method="post">
    <button class="pop-link" type="submit"><Icon name="logout" size={16} />Log out</button>
  </form>
</div>

<div id="nav-menu" class="pop glass" popover>
  <p class="seclabel">Back office</p>
  {
    links.map((l) => (
      <a class="pop-link" href={l.href} aria-current={current(l.match)}>
        <Icon name={l.icon} size={16} />
        {l.label}
      </a>
    ))
  }
  <form action="/logout" method="post">
    <button class="pop-link" type="submit"><Icon name="logout" size={16} />Log out</button>
  </form>
</div>

<style>
  .app-header {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 22px;
    height: var(--header-h);
    padding: 0 var(--gutter);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--stroke);
  }

  .nav {
    display: flex;
    gap: 4px;
  }

  .nav a,
  .pop-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--mut);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
    transition:
      color 0.15s,
      background 0.15s;
  }

  button.pop-link {
    width: 100%;
    background: none;
    font: inherit;
    font-size: 0.86rem;
    cursor: pointer;
  }

  .out-btn {
    min-height: 36px;
    padding: 6px 14px;
  }

  .nav a:hover,
  .pop-link:hover {
    color: var(--ink);
    background: var(--hover);
  }

  .nav a[aria-current='page'],
  .pop-link[aria-current='page'] {
    color: var(--ink);
    border-color: var(--stroke-strong);
    background: var(--raised);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  .me {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--stroke-strong);
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-violet) 22%, transparent);
    color: var(--ink);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .menu-btn {
    display: none;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--stroke);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .pop {
    inset: calc(var(--header-h) + 8px) var(--gutter) auto auto;
    width: min(270px, calc(100vw - 2 * var(--gutter)));
    margin: 0;
    padding: 14px 10px 10px;
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  .pop .seclabel {
    margin: 0 8px 8px;
  }

  .who {
    margin: 0 8px;
    font-weight: 900;
  }

  .mail {
    margin: 0 8px;
    color: var(--mut);
    font-size: 0.8rem;
  }

  .role {
    margin: 8px 8px 10px;
  }

  .pop-link {
    display: flex;
    width: 100%;
    border-radius: 10px;
    font-size: 0.92rem;
  }

  @media (max-width: 760px) {
    .nav,
      .menu-btn {
      display: grid;
    }

    /* On phones Log out keeps its icon and its accessible name. */
    .out-btn {
      width: 36px;
      padding: 0;
    }

    .out-word {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .app-header {
      gap: 12px;
    }

    .tools {
      gap: 8px;
    }
  }
</style>
