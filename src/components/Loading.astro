---
// What a live screen shows while its server island reads the log API: the same heading, a spinner and
// placeholder tiles where the figures will go. The API can take several seconds to answer.
interface Props {
  title: string;
  lede: string;
  /** What is being read, e.g. "the bill payment log". */
  reading: string;
  admin?: boolean;
}

const { title, lede, reading, admin = false } = Astro.props;
---

<div class="page-head">
  <div>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/dashboard/">Home</a>{admin && <><span class="sep" aria-hidden="true">/</span><span>Monitoring</span></>}</nav>
    <h1 class="title">{title}</h1>
    <p>{lede}</p>
  </div>
  <div class="head-tools">
    <span class="pill" data-tone="info">Loading</span>
  </div>
</div>

<div class="loading" role="status" aria-live="polite">
  <span class="busy" aria-hidden="true"><i></i><i></i><i></i></span>
  <p>Loading {reading}…</p>
</div>

<div class="ghosts" aria-hidden="true">
  <span class="ghost glass"></span>
  <span class="ghost glass"></span>
  <span class="ghost glass"></span>
  <span class="ghost glass"></span>
  <span class="ghost glass wide"></span>
</div>

<style>
  .head-tools {
    display: flex;
    align-items: center;
  }

  .loading {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    color: var(--mut);
  }

  /* A busy indicator: three dots pulsing in turn. */
  .busy {
    display: inline-flex;
    gap: 4px;
  }

  .busy i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: busy 1.2s ease-in-out infinite;
  }

  .busy i:nth-child(2) {
    animation-delay: 0.2s;
  }

  .busy i:nth-child(3) {
    animation-delay: 0.4s;
  }

  .ghosts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .ghost {
    height: 144px;
    animation: pulse 1.4s ease-in-out infinite;
  }

  .ghost.wide {
    grid-column: 1 / -1;
    height: 280px;
  }

  @keyframes busy {
    0%,
    80%,
    100% {
      opacity: 0.25;
      transform: scale(0.8);
    }

    40% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .busy i {
      animation-duration: 2.4s;
    }

    .ghost {
      animation: none;
    }
  }

  @media (max-width: 760px) {
    .ghosts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
