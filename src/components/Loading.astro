---
// What a live screen shows while its server island reads the log API: the same heading, a spinner and
// placeholder tiles where the figures will go. The API can take several seconds to answer.
interface Props {
  title: string;
  lede: string;
  /** What is being read, e.g. "the bill payment log". */
  reading: string;
  admin?: boolean;
}

const { title, lede, reading, admin = false } = Astro.props;
---

<div class="page-head">
  <div>
    <p class="eyebrow">Back office{admin && <> · <span class="audience">Admin</span></>}</p>
    <h1 class="title">{title}<span class="pd">.</span></h1>
    <p>{lede}</p>
  </div>
  <div class="head-tools">
    <span class="pill" data-tone="info">Reading live data…</span>
  </div>
</div>

<div class="loading" role="status" aria-live="polite">
  <span class="spinner" aria-hidden="true"></span>
  <p>
    <strong>Reading {reading}…</strong>
    <span class="muted">This can take a few seconds.</span>
  </p>
</div>

<div class="ghosts" aria-hidden="true">
  <span class="ghost glass"></span>
  <span class="ghost glass"></span>
  <span class="ghost glass"></span>
  <span class="ghost glass"></span>
  <span class="ghost glass wide"></span>
</div>

<style>
  .audience {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-2);
  }

  .audience::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--c-violet);
  }

  .head-tools .pill {
    padding: 6px 12px;
    font-size: 0.74rem;
  }

  .loading {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  .loading p {
    display: grid;
    gap: 2px;
    font-size: 0.9rem;
  }

  .spinner {
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    border: 3px solid var(--stroke-strong);
    border-top-color: var(--select);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .ghosts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .ghost {
    height: 112px;
    border-radius: var(--radius);
    animation: pulse 1.4s ease-in-out infinite;
  }

  .ghost.wide {
    grid-column: 1 / -1;
    height: 260px;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation-duration: 2.4s;
    }

    .ghost {
      animation: none;
    }
  }

  @media (max-width: 760px) {
    .ghosts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
