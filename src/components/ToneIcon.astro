---
import type { Tone } from '../lib/flow';

interface Props {
  tone: Tone;
  class?: string;
}

const { tone, class: cls } = Astro.props;
---

<svg
  class:list={['tone-icon', cls]}
  data-tone={tone}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {tone === 'ok' && <path d="m4 8.4 2.6 2.5L12 5.3" />}
  {tone === 'fail' && <path d="M5 5l6 6M11 5l-6 6" />}
  {
    tone === 'wait' && (
      <>
        <circle cx="8" cy="8" r="4.9" stroke-width="1.6" />
        <path d="M8 5.7V8l1.6 1.1" stroke-width="1.6" />
      </>
    )
  }
  {tone === 'info' && <circle cx="8" cy="8" r="2.2" fill="currentColor" stroke="none" />}
</svg>
