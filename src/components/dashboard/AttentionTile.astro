---
import Icon from '../Icon.astro';
import ToneIcon from '../ToneIcon.astro';
import type { Tone } from '../../lib/flow';

interface Props {
  tone: Tone;
  value: string;
  label: string;
  note: string;
  href: string;
}

const { tone, value, label, note, href } = Astro.props;
---

<a class="att glass" href={href} data-tone={tone}>
  <span class="att-icon"><ToneIcon tone={tone} ring /></span>
  <span class="att-body">
    <span class="att-top"><b class="att-val">{value}</b><span class="att-label">{label}</span></span>
    <span class="att-note">{note}</span>
  </span>
  <Icon name="chevron" size={16} class="att-go" />
</a>

<style>
  /* A navigation card: status icon, the count in its state colour, and a chevron to the filtered log. */
  .att {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.1s;
  }

  .att:hover {
    background: var(--hover);
  }

  [data-tone='ok'] {
    --tone: var(--ok-ink);
  }
  [data-tone='fail'] {
    --tone: var(--fail-ink);
  }
  [data-tone='wait'] {
    --tone: var(--wait-ink);
  }
  [data-tone='info'] {
    --tone: var(--info-ink);
  }

  .att-icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    color: var(--tone);
  }

  .att-icon :global(.tone-icon) {
    width: 24px;
    height: 24px;
  }

  .att-body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .att-top {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .att-val {
    color: var(--tone);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }

  .att-label {
    color: var(--ink-2);
    font-weight: 700;
  }

  .att-note {
    color: var(--mut);
    font-size: 0.875rem;
  }

  .att :global(.att-go) {
    flex: 0 0 auto;
    margin-left: auto;
    color: var(--mut);
    transform: rotate(-90deg);
  }
</style>
