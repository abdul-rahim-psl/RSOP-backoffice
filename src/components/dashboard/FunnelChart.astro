---
import Icon from '../Icon.astro';
import BarRows from './BarRows.astro';
import { int, pct } from '../../lib/format';

// Ordered stages take the ordinal blue ramp (validated with --ordinal), so the order shows in the colour too.
interface Props {
  stages: { label: string; value: number }[];
}

const { stages } = Astro.props;
const share = (i: number) => (i && stages[i - 1].value ? pct(stages[i].value, stages[i - 1].value) : null);
const rows = stages.map((s, i) => {
  const prev = stages[i - 1];
  const of = share(i);
  return {
    label: s.label,
    value: s.value,
    shown: int(s.value),
    note: of ? `${of} of ${prev.label.toLowerCase()}` : undefined,
    color: `var(--viz-o${i + 1})`,
    tip: {
      title: s.label,
      rows: [
        { value: int(s.value), label: 'today', key: `var(--viz-o${i + 1})` },
        ...(of ? [{ value: of, label: `of ${prev!.label.toLowerCase()}` }] : []),
      ],
    },
  };
});
---

<figure class="chart glass">
  <div class="chart-head">
    <h3>From inquiry to paid bill</h3>
    <p>Counts from both logs; a payment isn't matched to its inquiry</p>
  </div>

  <BarRows rows={rows} max={Math.max(1, ...stages.map((s) => s.value))} />

  <details class="table-view">
    <summary><Icon name="table" size={15} />Show as a table</summary>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Stage</th><th class="num">Today</th><th class="num">Of the stage before</th></tr></thead>
        <tbody>
          {
            stages.map((s, i) => (
              <tr>
                <td>{s.label}</td>
                <td class="num">{int(s.value)}</td>
                <td class="num">{share(i) ?? '—'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>
