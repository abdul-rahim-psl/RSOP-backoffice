---
import Icon from '../Icon.astro';

interface Props {
  label: string;
  value: string;
  /** Signed change against a named period; colour follows whether up is good. */
  delta?: { text: string; good: boolean; vs: string };
  /** Hourly points for the sparkline; the latest is drawn in the accent. */
  trend?: number[];
  hero?: boolean;
  sub?: string;
}

const { label, value, delta, trend, hero = false, sub } = Astro.props;

const W = 120;
const H = 32;
const spark =
  trend && trend.length > 1
    ? (() => {
        const max = Math.max(...trend);
        const min = Math.min(...trend);
        const x = (i: number) => 4 + (i / (trend.length - 1)) * (W - 8);
        const y = (v: number) => H - 4 - ((v - min) / (max - min || 1)) * (H - 8);
        const pts = trend.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`);
        return { line: `M${pts.join('L')}`, end: { x: x(trend.length - 1), y: y(trend[trend.length - 1]) } };
      })()
    : null;
---

<div class:list={['stat glass', { hero }]}>
  <p class="label">{label}</p>
  <p class="value">{value}</p>
  {sub && <p class="sub">{sub}</p>}
  {
    delta && (
      <p class="delta" data-good={String(delta.good)}>
        <Icon name="arrow" size={13} class={delta.text.startsWith('−') ? 'down' : 'up'} />
        <span>
          <b>{delta.text}</b> {delta.vs}
        </span>
      </p>
    )
  }
  {
    spark && (
      <div class="spark" aria-hidden="true">
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
          <path d={spark.line} />
        </svg>
        {/* An HTML dot, so stretching the line never squashes it into an ellipse. */}
        <span class="dot" style={`left:${((spark.end.x / W) * 100).toFixed(2)}%;top:${((spark.end.y / H) * 100).toFixed(2)}%`} />
      </div>
    )
  }
</div>

<style>
  /* A KPI tile: muted label, large figure, short context lines, then the hourly microchart. */
  .stat {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto auto 1fr;
    gap: 2px;
    min-width: 0;
    padding: 16px;
  }

  .label {
    color: var(--mut);
    font-size: 0.875rem;
  }

  .value {
    margin: 4px 0 2px;
    color: var(--ink-2);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }

  .sub {
    color: var(--mut);
    font-size: 0.875rem;
  }

  .delta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--mut);
    font-size: 0.75rem;
  }

  .delta b {
    font-weight: 700;
  }

  .delta[data-good='true'] b,
  .delta[data-good='true'] :global(.icon) {
    color: var(--ok-ink);
  }

  .delta[data-good='false'] b,
  .delta[data-good='false'] :global(.icon) {
    color: var(--fail-ink);
  }

  .delta :global(.up) {
    transform: rotate(-45deg);
  }

  .delta :global(.down) {
    transform: rotate(45deg);
  }

  .spark {
    position: relative;
    align-self: end;
    height: 32px;
    margin-top: 12px;
  }

  .spark svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .spark path {
    fill: none;
    stroke: var(--viz-1);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .dot {
    position: absolute;
    width: 8px;
    height: 8px;
    border: 2px solid var(--panel-solid);
    border-radius: 50%;
    background: var(--viz-1);
    box-sizing: content-box;
    transform: translate(-50%, -50%);
  }
</style>
