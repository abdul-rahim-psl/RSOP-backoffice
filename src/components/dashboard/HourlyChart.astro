---
import Icon from '../Icon.astro';
import ToneIcon from '../ToneIcon.astro';
import { int } from '../../lib/format';

// Two colours only, SUCCESS and not: the palette has no third series colour that passes beside red, so the
// tooltip and the table split "not" into error replies and no reply.
interface Props {
  title: string;
  note: string;
  hours: string[];
  hourly: { ok: number[]; error: number[]; silent: number[] };
  okLabel: string;
  /** The log screen the legend's counts link to. */
  href: string;
}

const { title, note, hours, hourly, okLabel, href } = Astro.props;
const not = hours.map((_, i) => hourly.error[i] + hourly.silent[i]);
const totals = hours.map((_, i) => hourly.ok[i] + not[i]);
const peak = Math.max(0, ...totals);
const peakAt = totals.indexOf(peak);
const step = [1, 2, 5, 10, 20, 25, 50, 100, 250, 500].find((s) => peak / s <= 5) ?? 1000;
const top = Math.max(step, Math.ceil(peak / step) * step);
const ticks = Array.from({ length: top / step + 1 }, (_, i) => i * step);
const until = (h: string) => `${String(Number(h.slice(0, 2)) + 1).padStart(2, '0')}:00`;

const tip = (i: number) =>
  JSON.stringify({
    title: `${hours[i]}–${until(hours[i])}`,
    rows: [
      { value: String(hourly.ok[i]), label: okLabel, key: 'var(--viz-settled)' },
      { value: String(hourly.error[i]), label: 'Error reply', key: 'var(--viz-refused)' },
      { value: String(hourly.silent[i]), label: 'No reply', key: 'var(--viz-refused)' },
    ],
  });
---

<figure class="chart glass hourly">
  <div class="chart-head">
    <h3>{title}</h3>
    <p>{note}</p>
  </div>

  <ul class="legend-row">
    <li><span class="key" style="--key: var(--viz-settled)"></span><ToneIcon tone="ok" />{okLabel}</li>
    <li><span class="key" style="--key: var(--viz-refused)"></span><ToneIcon tone="fail" />Error or no reply</li>
  </ul>

  <div class="plot" style={`--top:${top};--cols:${hours.length}`}>
    <div class="grid" aria-hidden="true">
      {
        ticks.map((t) => (
          <span class="gl" style={`--v:${t}`}>
            <span class="tick mono">{t}</span>
          </span>
        ))
      }
    </div>
    <ol class="cols">
      {
        hours.map((h, i) => (
          <li
            class="col mark"
            tabindex="0"
            style={`--total:${totals[i]}`}
            data-tip={tip(i)}
            aria-label={`${h} to ${until(h)}: ${hourly.ok[i]} ${okLabel.toLowerCase()}, ${hourly.error[i]} error replies, ${hourly.silent[i]} with no reply`}
          >
            <span class="stack">
              <span class="seg not" style={`--n:${not[i]}`} />
              <span class="seg ok" style={`--n:${hourly.ok[i]}`} />
            </span>
            {i === peakAt && peak > 0 && <span class="peak">{peak}</span>}
            <span class="xl mono">{h}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="chart-note">
    {int(totals.reduce((a, b) => a + b, 0))} today, by the hour they were logged in Pakistan time. <a href={href}>Open the log</a>
  </p>

  <details class="table-view">
    <summary><Icon name="table" size={15} />Show as a table</summary>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Hour</th><th class="num">{okLabel}</th><th class="num">Error reply</th><th class="num">No reply</th><th class="num">Total</th></tr>
        </thead>
        <tbody>
          {
            hours.map((h, i) => (
              <tr>
                <td class="mono">{h}–{until(h)}</td>
                <td class="num">{hourly.ok[i]}</td>
                <td class="num">{hourly.error[i]}</td>
                <td class="num">{hourly.silent[i]}</td>
                <td class="num">{totals[i]}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  /* --head leaves room above the top gridline for the peak's label. */
  .plot {
    --axis: 24px;
    --gutter: 36px;
    --head: 20px;
    position: relative;
    height: 250px;
  }

  .grid {
    position: absolute;
    inset: var(--head) 0 var(--axis) var(--gutter);
  }

  .gl {
    position: absolute;
    right: 0;
    bottom: calc(var(--v) / var(--top) * 100%);
    left: 0;
    border-top: 1px solid var(--viz-grid);
  }

  .gl:first-child {
    border-top-color: var(--viz-axis);
  }

  .tick {
    position: absolute;
    right: calc(100% + 8px);
    bottom: -7px;
    color: var(--faint);
    font-size: 0.68rem;
  }

  .cols {
    position: absolute;
    inset: var(--head) 0 0 var(--gutter);
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
  }

  .col {
    position: relative;
    border-radius: 8px;
  }

  .col:hover,
  .col:focus-visible {
    background: var(--raised);
  }

  /* Thin columns (≤ 24px), square at the baseline, rounded at the data end; a 2px surface gap between segments. */
  .stack {
    position: absolute;
    bottom: var(--axis);
    left: 50%;
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: min(24px, 55%);
    height: calc(var(--total) / var(--top) * (100% - var(--axis)));
    transform: translateX(-50%);
  }

  .seg {
    flex: var(--n) 1 0;
    min-height: 0;
  }

  .seg.ok {
    background: var(--viz-settled);
  }

  .seg.not {
    background: var(--viz-refused);
  }

  .stack > :first-child {
    border-radius: 4px 4px 0 0;
  }

  .col:hover .seg,
  .col:focus-visible .seg {
    filter: brightness(1.18);
  }

  .peak {
    position: absolute;
    bottom: calc(var(--axis) + var(--total) / var(--top) * (100% - var(--axis)) + 6px);
    left: 50%;
    color: var(--ink);
    font-size: 0.74rem;
    font-weight: 900;
    transform: translateX(-50%);
  }

  .xl {
    position: absolute;
    bottom: 2px;
    left: 50%;
    color: var(--faint);
    font-size: 0.68rem;
    transform: translateX(-50%);
  }

  @media (max-width: 560px) {
    .xl {
      font-size: 0.6rem;
    }

    .plot {
      --gutter: 30px;
      height: 220px;
    }
  }
</style>
