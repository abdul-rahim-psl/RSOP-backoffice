---
import Icon from '../Icon.astro';
import BarRows from './BarRows.astro';
import { byType, totals } from '../../data/dashboard';
import { compactPkr, int, pct, pkr } from '../../lib/format';

// Bill types are nominal, so every bar takes the one series colour; a single series needs no legend.
const sorted = [...byType].sort((a, b) => b.collected - a.collected);
const rows = sorted.map((t) => ({
  label: t.type,
  value: t.collected,
  shown: compactPkr(t.collected),
  note: `${int(t.payments)} payments · ${pct(t.collected, totals.collected, 0)} of the day`,
  color: 'var(--viz-1)',
  tip: {
    title: t.type,
    rows: [
      { value: pkr(t.collected), label: 'collected', key: 'var(--viz-1)' },
      { value: int(t.payments), label: 'settled payments' },
    ],
  },
}));
---

<figure class="chart glass">
  <div class="chart-head">
    <h3>Collected by bill type</h3>
    <p>Settled payments only</p>
  </div>

  <BarRows rows={rows} max={sorted[0].collected} />

  <details class="table-view">
    <summary><Icon name="table" size={15} />Show as a table</summary>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Bill type</th><th class="num">Payments</th><th class="num">Collected</th></tr></thead>
        <tbody>
          {
            sorted.map((t) => (
              <tr>
                <td>{t.type}</td>
                <td class="num">{int(t.payments)}</td>
                <td class="num">{pkr(t.collected)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>
