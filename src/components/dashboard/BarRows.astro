---
interface Row {
  label: string;
  code?: string;
  value: number;
  /** The value as printed at the bar's tip. */
  shown: string;
  note?: string;
  /** A CSS colour for the bar. */
  color: string;
  tip: { title: string; rows: { value: string; label: string; key?: string }[] };
}

interface Props {
  rows: Row[];
  max: number;
}

const { rows, max } = Astro.props;
---

<ol class="rows">
  {
    rows.map((r) => (
      <li
        class="row mark"
        tabindex="0"
        style={`--w:${(r.value / max).toFixed(4)};--bar:${r.color}`}
        data-tip={JSON.stringify(r.tip)}
        aria-label={`${r.label}${r.code ? ` (${r.code})` : ''}: ${r.shown}${r.note ? `, ${r.note}` : ''}`}
      >
        <span class="r-label">
          {r.label}
          {r.code && <span class="r-code mono">{r.code}</span>}
        </span>
        <span class="r-track">
          <span class="r-bar" />
          <span class="r-val">{r.shown}</span>
        </span>
        {r.note && <span class="r-note">{r.note}</span>}
      </li>
    ))
  }
</ol>

<style>
  .rows {
    display: grid;
    gap: 2px;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(96px, 32%) minmax(0, 1fr);
    align-items: center;
    gap: 0 12px;
    padding: 6px 8px;
    border-radius: 4px;
  }

  .row:hover,
  .row:focus-visible {
    background: var(--hover);
  }

  .r-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 6px;
    color: var(--ink);
    font-size: 0.875rem;
  }

  .r-code {
    color: var(--mut);
    font-size: 0.75rem;
  }

  /* The bar leaves room for its value at the tip; square at the baseline, slightly rounded at the data end. */
  .r-track {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .r-bar {
    flex: 0 0 auto;
    width: calc(var(--w) * (100% - 92px));
    height: 16px;
    border-radius: 0 2px 2px 0;
    background: var(--bar);
  }

  .r-val {
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .r-note {
    grid-column: 2;
    color: var(--mut);
    font-size: 0.75rem;
  }
</style>
