---
// A status as an icon plus coloured text, with no background, the way tables and lists show state.
import type { Tone } from '../lib/flow';
import ToneIcon from './ToneIcon.astro';

interface Props {
  tone: Tone;
  /** The status as the system writes it, e.g. 101 or AWAITING_ACSP; shown before the word. */
  code?: string;
  /** The plain word a reader needs, e.g. "Awaiting ACSP". */
  word?: string;
}

const { tone, code, word } = Astro.props;
---

<span class="status" data-tone={tone}>
  <ToneIcon tone={tone} ring />
  <span class="text">
    {code && <span class="code">{code}</span>}
    {word && <span class="word">{word}</span>}
  </span>
</span>

<style>
  .status {
    display: inline-flex;
    align-items: flex-start;
    gap: 6px;
    color: var(--tone-ink, var(--ink));
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.25rem;
  }

  .status[data-tone='ok'] {
    --tone-ink: var(--ok-ink);
  }

  .status[data-tone='fail'] {
    --tone-ink: var(--fail-ink);
  }

  .status[data-tone='wait'] {
    --tone-ink: var(--wait-ink);
  }

  .status[data-tone='info'] {
    --tone-ink: var(--info-ink);
  }

  .status :global(.tone-icon) {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin-top: 2px;
  }

  .text {
    min-width: 0;
  }

  .code + .word::before {
    content: ' ';
  }
</style>
