<button class="toggle" type="button" aria-label="Dark theme" aria-pressed="false" title="Dark theme" data-theme-toggle>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a6.8 6.8 0 0 0 10.8 10.8Z" />
  </svg>
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" />
    <path
      d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.55 1.55M17.15 17.15l1.55 1.55M5.3 18.7l1.55-1.55M17.15 6.85l1.55-1.55"
    />
  </svg>
</button>

<script>
  const KEY = 'rsop-ui-theme';
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  const isDark = () => root.dataset.theme === 'dark';

  // Storage can be unavailable (private browsing, blocked cookies); the pick then lasts for this page only.
  function save(theme: string) {
    try {
      localStorage.setItem(KEY, theme);
    } catch {}
  }

  function apply(dark: boolean) {
    root.classList.add('theme-switching');
    if (dark) root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    button?.setAttribute('aria-pressed', String(dark));
    // Flush styles while transitions are off, so turning them back on animates nothing.
    getComputedStyle(root).color;
    setTimeout(() => root.classList.remove('theme-switching'));
  }

  button?.setAttribute('aria-pressed', String(isDark()));
  button?.addEventListener('click', () => {
    const dark = !isDark();
    apply(dark);
    save(dark ? 'dark' : 'light');
  });
</script>

<style>
  .toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .toggle:hover {
    color: var(--ink);
    background: var(--hover);
  }

  svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .sun,
  :global([data-theme='dark']) .moon {
    display: none;
  }

  :global([data-theme='dark']) .sun {
    display: block;
  }
</style>
