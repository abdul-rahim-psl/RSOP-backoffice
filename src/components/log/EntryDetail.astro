---
import Icon from '../Icon.astro';
import StatusPill from '../StatusPill.astro';
import type { Header, LogEntry, LogKind } from '../../data/api/bill-log';
import { duration, pkr, pktTime, pktWhen } from '../../lib/format';

interface Props {
  q: LogEntry;
  kind: LogKind;
  now: Date;
  /** When the log was read; a snapshot's is older than the page. */
  readAt: string;
  /** How many entries in the log carry this one's request ID. */
  shared: number;
}

const { q, kind, now, readAt, shared } = Astro.props;
const o = kind.outcomes.find((x) => x.id === q.outcome)!;
const word = q.outcome === 'error' ? q.desc || o.label : o.label;

const story =
  q.outcome === 'returned'
    ? `SUCCESS came back in ${duration(q.replyMs ?? 0)}, ${kind.okStory}.`
    : q.outcome === 'error'
      ? `A reply came back${q.replyMs !== null ? ` in ${duration(q.replyMs)}` : ''}: ${q.desc || 'no description'}${q.code ? ` (code ${q.code})` : ''}.`
      : `No reply was recorded. It was logged at ${pktTime(q.at)}, and nothing had come back by ${pktWhen(readAt, now)}, when the log was read.`;

const others = shared - 1;
// The payment log records the payment, not the raw call: with no headers, rows that could only say
// "Not recorded" fold into the one line under the IDs.
const bare = q.request.length === 0 && q.response.length === 0;
const allIds: { label: string; value: string | null; note?: string }[] = [
  ...(q.billId ? [{ label: 'Bill ID', value: q.billId }] : []),
  { label: 'Correlation ID', value: q.correlationId },
  {
    label: 'Request ID',
    value: q.requestId,
    note: others > 0 ? `Also on ${others} other ${others === 1 ? kind.one : kind.many} in this log, so it can't tell them apart.` : undefined,
  },
  { label: 'Log ID', value: String(q.id) },
  ...(q.rrn ? [{ label: 'RRN', value: q.rrn }] : []),
  ...(q.stan ? [{ label: 'STAN', value: q.stan }] : []),
  ...(q.originalMessageId ? [{ label: 'Original message ID', value: q.originalMessageId }] : []),
];
const ids = bare ? allIds.filter((id) => id.value) : allIds;
const unset = [
  ...(bare ? allIds.filter((id) => !id.value).map((id) => id.label[0].toLowerCase() + id.label.slice(1)) : []),
  !q.rrn && 'RRN',
  !q.stan && 'STAN',
  !q.originalMessageId && 'original message ID',
  bare && 'headers',
].filter((x): x is string => !!x);
const unsetText = unset.length > 1 ? `${unset.slice(0, -1).join(', ')} and ${unset.at(-1)}` : unset[0];

const allWho: { label: string; value: string | null; mono?: boolean; sub?: string }[] = [
  { label: 'Sender participant', value: q.sender, mono: true },
  { label: 'Sender user', value: q.senderUser, mono: true },
  { label: 'Receiver participant', value: q.receiver, mono: true },
  { label: 'Called from', value: q.local ? "The log's own server" : q.ip, mono: !q.local, sub: q.local ? `loopback, ${q.ip}` : undefined },
  { label: 'Client', value: q.client, mono: true },
  { label: 'Addressed to', value: q.host, mono: true },
];
const who = bare ? allWho.filter((w) => w.value) : allWho;

const headerSets: { title: string; list: Header[] }[] = bare
  ? []
  : [
      { title: 'Request headers', list: q.request },
      { title: 'Response headers', list: q.response },
    ];
---

<article class="entry" id={`${kind.anchor}-${q.id}`} aria-labelledby={`${kind.anchor}-${q.id}-h`}>
  <header class="entry-head">
    <p class="eyebrow">{kind.One} {q.id}</p>
    <h3 id={`${kind.anchor}-${q.id}-h`}>
      {q.billRef ? <>Bill <span class="mono">{q.billRef}</span></> : 'No bill reference'}
    </h3>
    <dl class="head-attrs">
      {
        q.amount !== null && (
          <div>
            <dt>Amount</dt>
            <dd class="amount">{pkr(q.amount)}</dd>
          </div>
        )
      }
      <div>
        <dt>Result</dt>
        <dd><StatusPill tone={o.tone} code={q.outcome === 'error' ? (q.code ?? undefined) : undefined} word={word} /></dd>
      </div>
    </dl>
    <p class="story">{story}</p>
  </header>

  <section class="block">
    <h4>When</h4>
    <dl class="facts">
      <div>
        <dt>{kind.asked}</dt>
        <dd><time datetime={q.at}>{pktWhen(q.at, now)}</time></dd>
      </div>
      <div>
        <dt>Answered</dt>
        <dd>{q.repliedAt ? <time datetime={q.repliedAt}>{pktWhen(q.repliedAt, now)}</time> : <span class="none">No reply recorded</span>}</dd>
      </div>
      <div>
        <dt>Reply time</dt>
        <dd>{q.replyMs !== null ? duration(q.replyMs) : <span class="none">—</span>}</dd>
      </div>
    </dl>
  </section>

  <section class="block">
    <h4>{kind.whoAsked}</h4>
    <dl class="facts">
      {
        who.map((w) => (
          <div>
            <dt>{w.label}</dt>
            <dd>
              {w.value ? <span class:list={{ mono: w.mono }}>{w.value}</span> : <span class="none">Not recorded</span>}
              {w.sub && <span class="sub mono">{w.sub}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="block">
    <h4>IDs for tracing</h4>
    <dl class="facts">
      {
        ids.map((id) => (
          <div>
            <dt>{id.label}</dt>
            <dd>
              {id.value ? (
                <span class="id">
                  <span class="mono">{id.value}</span>
                  <button class="copy" type="button" data-copy={id.value} data-copy-label={id.label} aria-label={`Copy ${id.label}`} title="Copy">
                    <Icon name="copy" size={16} />
                  </button>
                </span>
              ) : (
                <span class="none">Not recorded</span>
              )}
              {id.note && <span class="warn">{id.note}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
    {unsetText && <p class="unset">Not recorded for this {kind.one}: {unsetText}</p>}
  </section>

  {
    headerSets.map((h) => (
      <details class="hdrs">
        <summary>
          <Icon name="chevron" size={16} />
          {h.title}
          <span class="count">({h.list.length})</span>
        </summary>
        {h.list.length ? (
          <table class="hdr-table">
            <caption class="sr-only">{h.title}</caption>
            <tbody>
              {h.list.map(([name, value]) => (
                <tr>
                  <th scope="row" class="mono">{name}</th>
                  <td class="mono">{value || <span class="none">empty</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="unset">None recorded</p>
        )}
      </details>
    ))
  }
</article>

<style>
  .entry {
    display: grid;
  }

  /* Object header: identifier, title, key attributes, then the one-line summary. */
  .entry-head {
    display: grid;
    gap: 8px;
    padding-bottom: 16px;
  }

  .eyebrow {
    margin: 0;
  }

  h3 {
    color: var(--ink-2);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  h3 .mono {
    font-weight: 700;
  }

  .head-attrs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 40px;
    margin-top: 4px;
  }

  .head-attrs > div {
    display: grid;
    gap: 2px;
  }

  .head-attrs dd {
    font-size: 0.875rem;
  }

  .head-attrs dd.amount {
    color: var(--ink-2);
    font-size: 1.25rem;
    line-height: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  .story {
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  /* Sections: a bold title over a label-value form. */
  .block {
    display: grid;
    gap: 8px;
    padding: 16px 0;
    border-top: 1px solid var(--stroke);
  }

  h4 {
    color: var(--ink-2);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5rem;
  }

  .facts {
    display: grid;
    gap: 2px;
  }

  .facts > div {
    display: grid;
    grid-template-columns: minmax(130px, 38%) minmax(0, 1fr);
    align-items: baseline;
    gap: 16px;
    min-height: 32px;
    padding: 5px 0;
  }

  dt {
    color: var(--mut);
    font-size: 0.875rem;
  }

  dd {
    min-width: 0;
    color: var(--ink);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  dd .mono {
    font-size: 0.8125rem;
  }

  .sub {
    display: block;
    color: var(--mut);
    font-size: 0.75rem;
  }

  .none {
    color: var(--mut);
  }

  .id {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* Icon-only buttons are transparent. */
  .copy {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 26px;
    height: 26px;
    margin: -4px 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--link);
    cursor: pointer;
  }

  .copy:hover {
    background: var(--hover);
  }

  .copy[data-done] {
    color: var(--ok-ink);
  }

  /* Copying needs the script; without it the ID is still there to select. */
  :global(html:not(.js)) .copy {
    display: none;
  }

  .warn {
    display: block;
    margin-top: 2px;
    color: var(--wait-ink);
    font-size: 0.75rem;
  }

  .unset {
    color: var(--mut);
    font-size: 0.75rem;
  }

  /* Headers: collapsible panels with a key-value table. */
  .hdrs {
    border-top: 1px solid var(--stroke);
  }

  .hdrs summary {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .hdrs summary::-webkit-details-marker {
    display: none;
  }

  .hdrs summary :global(.icon) {
    color: var(--mut);
    transform: rotate(-90deg);
    transition: transform 0.15s;
  }

  .hdrs[open] summary :global(.icon) {
    transform: none;
  }

  .count {
    color: var(--mut);
    font-weight: 400;
  }

  .hdrs > .unset {
    padding: 0 0 12px 24px;
  }

  .hdr-table {
    width: 100%;
    margin-bottom: 12px;
    border-collapse: collapse;
    font-size: 0.75rem;
  }

  .hdr-table th,
  .hdr-table td {
    padding: 6px 8px;
    border-bottom: 1px solid var(--stroke);
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .hdr-table tr:first-child th,
  .hdr-table tr:first-child td {
    border-top: 1px solid var(--stroke);
  }

  .hdr-table th {
    width: 40%;
    color: var(--mut);
    font-weight: 400;
  }

  @media (max-width: 480px) {
    .facts > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
