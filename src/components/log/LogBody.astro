---
// A log screen's content, read from the log API on the server. LogScreen renders it as a server island,
// so the page shows a loader at once and this replaces it when the log has been read.
import Icon from '../Icon.astro';
import ToneIcon from '../ToneIcon.astro';
import StatusPill from '../StatusPill.astro';
import StatTile from '../dashboard/StatTile.astro';
import AttentionTile from '../dashboard/AttentionTile.astro';
import EntryDetail from './EntryDetail.astro';
import { fetchLog, logs, summarize, type LogEntry, type LogId } from '../../data/api/bill-log';
import { ago, compactPkr, duration, int, pct, pkr, pkt, pktTime, pktWhen } from '../../lib/format';

interface Props {
  log: LogId;
}

const kind = logs[Astro.props.log];
const { outcomes, one, many, anchor } = kind;

/** Keeps a long log's page light; the figures still count every entry. */
const SHOWN = 300;

const src = await fetchLog(kind);
const now = new Date();
const list = src.entries;
const sum = summarize(list);
const rows = list.slice(0, SHOWN);
const byId = Object.fromEntries(outcomes.map((o) => [o.id, o]));
// Columns appear only when the log records them: the payment log carries amounts, the inquiry log the caller.
const priced = list.some((q) => q.amount !== null);
const hasCaller = rows.some((q) => q.ip || q.client);
const cols = 5 + Number(priced) + Number(hasCaller);

const pill = src.live
  ? { tone: 'ok', text: `Live · read ${pktTime(src.fetchedAt)}`, about: `Read from ${src.url} at ${pkt(src.fetchedAt)} PKT` }
  : {
      tone: 'wait',
      text: `Log unreachable · snapshot ${pkt(src.fetchedAt, true)}`,
      about: `${src.tried} could not be read (${src.error}), so this is the snapshot of ${src.url} taken ${pkt(src.fetchedAt)} PKT`,
    };

const errorsNote = sum.errors
  .slice(0, 2)
  .map(([desc, n]) => (n > 1 ? `${desc} (${n})` : desc))
  .join(' · ');

const searchText = (q: LogEntry) =>
  [q.billRef, q.billId, q.id, q.amount, q.correlationId, q.requestId, q.ip, q.code, q.desc, q.sender, q.senderUser, q.receiver, q.client]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
---

<div class="page-head">
  <div>
    <p class="eyebrow">Back office · <span class="audience">Admin</span></p>
    <h1 class="title">{kind.title}<span class="pd">.</span></h1>
    <p>Every bill {one} the log has recorded, newest first, and what came back.</p>
  </div>
  <div class="head-tools">
    <span class="pill" data-tone={pill.tone} title={pill.about}>
      {pill.text}
      <span class="sr-only">: {pill.about}</span>
    </span>
    <a class="btn" href="" data-refresh><Icon name="retry" size={16} />Refresh</a>
  </div>
</div>

{
  sum.total === 0 ? (
    <section class="state glass" aria-labelledby="empty-h" data-tone="info">
      <span class="state-icon">
        <ToneIcon tone="info" />
      </span>
      <div class="state-body">
        <h2 id="empty-h">No {many} logged yet</h2>
        <p class="muted">The log answered with an empty list at {pktTime(src.fetchedAt)} PKT. Refresh after the next bill {one}.</p>
      </div>
    </section>
  ) : (
    <>
      <section aria-labelledby="sum-h">
        <h2 id="sum-h" class="sr-only">Summary</h2>
        <div class="kpis">
          <StatTile label={`${kind.Many} logged`} value={int(sum.total)} sub={`Since ${pktWhen(sum.oldest!, now)}`} />
          {priced ? (
            <StatTile
              label="Collected"
              value={compactPkr(sum.collected)}
              sub={`${int(sum.counts.returned)} of ${int(sum.total)} ${many} ${kind.okKpi.toLowerCase()} · ${pct(sum.counts.returned, sum.total, 0)}`}
            />
          ) : (
            <StatTile
              label={kind.okKpi}
              value={pct(sum.counts.returned, sum.total, 0)}
              sub={`${int(sum.counts.returned)} of ${int(sum.total)} ${many}`}
            />
          )}
          <StatTile
            label="Typical reply time"
            value={sum.medianMs !== null ? duration(sum.medianMs) : '—'}
            sub={sum.slowestMs !== null ? `Median · slowest ${duration(sum.slowestMs)}` : 'No replies yet'}
          />
          <StatTile label={`Last ${one}`} value={ago(sum.newest!, now)} sub={pktWhen(sum.newest!, now)} />
        </div>

        <div class="attention">
          <p class="seclabel">Needs attention</p>
          {sum.counts.silent || sum.counts.error ? (
            <div class="att-grid">
              {sum.counts.silent > 0 && (
                <AttentionTile
                  tone="wait"
                  value={int(sum.counts.silent)}
                  label="No reply"
                  note="Logged, but no reply was recorded"
                  href="?show=silent#log"
                />
              )}
              {sum.counts.error > 0 && (
                <AttentionTile
                  tone="fail"
                  value={int(sum.counts.error)}
                  label={sum.counts.error === 1 ? 'Error reply' : 'Error replies'}
                  note={errorsNote}
                  href="?show=error#log"
                />
              )}
            </div>
          ) : (
            <p class="all-clear">
              <ToneIcon tone="ok" />
              Nothing needs attention: every {one} came back SUCCESS.
            </p>
          )}
        </div>
      </section>

      <section class="log" id="log" aria-labelledby="log-h" data-log data-anchor={anchor} data-many={many} data-seen-key={`rsop-${many}-seen`}>
        <div class="section-head">
          <h2 id="log-h">Log<span class="pd">.</span></h2>
          <p>
            Newest first, in Pakistan time. Select {kind.aOne} for its IDs, participants and headers.
            <span class="new-note" data-new-note hidden></span>
          </p>
        </div>

        <div class="filters">
          <label class="search">
            <Icon name="search" size={16} />
            <span class="sr-only">Search {many}</span>
            <input
              class="input"
              type="search"
              placeholder="Bill reference, ID, participant or IP"
              autocomplete="off"
              data-search
            />
          </label>
          <div class="chips" role="group" aria-label={`Show ${many} by result`}>
            <button class="chip" type="button" data-show="all" aria-pressed="true">
              All <span class="count">{int(sum.total)}</span>
            </button>
            {outcomes.map((o) => (
              <button class="chip" type="button" data-show={o.id} data-tone={o.tone} aria-pressed="false">
                <ToneIcon tone={o.tone} />
                {o.label}
                <span class="count">{int(sum.counts[o.id])}</span>
              </button>
            ))}
          </div>
        </div>

        <details class="help">
          <summary>
            <Icon name="info" size={15} />
            What the results mean
          </summary>
          <dl>
            {outcomes.map((o) => (
              <div>
                <dt>
                  <StatusPill tone={o.tone} word={o.label} />
                </dt>
                <dd>{o.means}</dd>
              </div>
            ))}
          </dl>
        </details>

        <p class="sr-only" aria-live="polite" data-log-status></p>

        <div class="table-wrap">
          <table class="table log-table">
            <caption class="sr-only">{kind.title}, newest first</caption>
            <thead>
              <tr>
                <th scope="col">Time</th>
                <th scope="col">Bill reference</th>
                {priced && <th scope="col" class="num">Amount</th>}
                <th scope="col">Result</th>
                <th scope="col" class="num">Reply time</th>
                {hasCaller && <th scope="col">Called from</th>}
                <th scope="col">
                  <span class="sr-only">Details</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {rows.map((q) => (
                <tr data-row data-id={q.id} data-at={q.at} data-show={q.outcome} data-text={searchText(q)}>
                  <td class="when">
                    <time datetime={q.at}>{pktWhen(q.at, now)}</time>
                    <span class="sub">
                      {ago(q.at, now)}
                      <span class="new-tag" data-new hidden>
                        New
                      </span>
                    </span>
                  </td>
                  <td class="ref mono">{q.billRef ?? <span class="none">none</span>}</td>
                  {priced && <td class="num amount">{q.amount !== null ? pkr(q.amount) : <span class="none">—</span>}</td>}
                  <td>
                    <StatusPill
                      tone={byId[q.outcome].tone}
                      code={q.outcome === 'error' ? (q.code ?? undefined) : undefined}
                      word={q.outcome === 'error' ? q.desc || byId.error.label : byId[q.outcome].label}
                    />
                  </td>
                  <td class="num">{q.replyMs !== null ? duration(q.replyMs) : <span class="none">—</span>}</td>
                  {hasCaller && (
                    <td class="caller">
                      <span class:list={{ mono: !q.local }}>{q.local ? 'Same server' : (q.ip ?? '—')}</span>
                      {q.client && <span class="sub mono">{q.client}</span>}
                    </td>
                  )}
                  <td class="go">
                    <a href={`#${anchor}-${q.id}`} data-open aria-label={`Details of ${one} ${q.id}`}>
                      Details
                      <Icon name="arrow" size={13} />
                    </a>
                  </td>
                </tr>
              ))}
              <tr class="empty" data-empty hidden>
                <td colspan={cols}>
                  No {many} match.
                  <button class="linkish" type="button" data-clear>
                    Show all
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        {list.length > SHOWN && (
          <p class="chart-note">
            Showing the newest {int(SHOWN)} of {int(list.length)}; the figures above count all of them.
          </p>
        )}
      </section>

      <section class="store" aria-labelledby="store-h" data-store>
        <div class="section-head">
          <h2 id="store-h">{kind.One} details<span class="pd">.</span></h2>
        </div>
        <div class="store-list">
          {rows.map((q) => (
            <div class="store-card glass">
              <EntryDetail q={q} kind={kind} now={now} readAt={src.fetchedAt} shared={q.requestId ? (sum.requestIds.get(q.requestId) ?? 1) : 1} />
            </div>
          ))}
        </div>
      </section>

      <dialog class="drawer" aria-label={`${kind.One} details`} data-drawer>
        <div class="drawer-in">
          <div class="drawer-bar">
            <div class="steps" role="group" aria-label="Move through the log">
              <button class="dbtn" type="button" data-step="-1">
                <Icon name="chevron" size={15} class="up" />
                Newer
              </button>
              <button class="dbtn" type="button" data-step="1">
                <Icon name="chevron" size={15} />
                Older
              </button>
            </div>
            <button class="dbtn sq" type="button" data-close aria-label="Close details">
              <Icon name="x" size={16} />
            </button>
          </div>
          <div class="drawer-body" data-drawer-body />
          <p class="sr-only" aria-live="polite" data-copy-status />
        </div>
      </dialog>
    </>
  )
}

<style>
  .audience {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-2);
  }

  .audience::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--c-violet);
  }

  .head-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .head-tools .pill {
    padding: 6px 12px;
    font-size: 0.74rem;
  }

  .state {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 22px 24px;
  }

  .state[data-tone='info'] {
    --tone: var(--info);
  }

  .state-icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--tone) 16%, transparent);
    color: var(--tone);
  }

  .state-icon :global(.tone-icon) {
    width: 22px;
    height: 22px;
  }

  .state-body {
    display: grid;
    justify-items: start;
    gap: 8px;
    min-width: 0;
  }

  .state-body h2 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .state-body .mono {
    font-size: 0.82rem;
    overflow-wrap: anywhere;
  }

  .state-body .btn {
    margin-top: 6px;
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .attention {
    display: grid;
    gap: 10px;
    margin: 22px 0 0;
  }

  .att-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .all-clear {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border: 1px solid color-mix(in srgb, var(--ok) 40%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--ok) 8%, transparent);
    font-weight: 700;
  }

  .all-clear :global(.tone-icon) {
    width: 18px;
    height: 18px;
    color: var(--ok-ink);
  }

  .new-note {
    color: var(--select);
    font-weight: 800;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .search {
    position: relative;
    flex: 0 1 360px;
  }

  .search :global(.icon) {
    position: absolute;
    top: 50%;
    left: 13px;
    color: var(--faint);
    transform: translateY(-50%);
  }

  .search .input {
    padding-left: 38px;
    border-radius: 999px;
  }

  .chip[data-tone='ok'] {
    --tone: var(--ok);
  }

  .chip[data-tone='fail'] {
    --tone: var(--fail);
  }

  .chip[data-tone='wait'] {
    --tone: var(--wait);
  }

  .chip :global(.tone-icon) {
    width: 14px;
    height: 14px;
    color: var(--tone);
  }

  .help {
    margin-bottom: 14px;
    font-size: 0.82rem;
  }

  .help summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--mut);
    font-weight: 800;
    cursor: pointer;
    list-style: none;
  }

  .help summary::-webkit-details-marker {
    display: none;
  }

  .help dl {
    display: grid;
    gap: 8px;
    margin-top: 10px;
    padding: 12px 14px;
    border: 1px solid var(--stroke);
    border-radius: var(--radius-sm);
    background: var(--raised);
  }

  .help dl > div {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
  }

  .help dd {
    color: var(--ink-2);
  }

  .log-table {
    min-width: 860px;
  }

  .log-table tbody tr[data-row] {
    cursor: pointer;
  }

  .log-table tbody tr[data-current] td {
    background: color-mix(in srgb, var(--select) 10%, transparent);
  }

  .log-table td.num,
  .ref {
    white-space: nowrap;
  }

  .when time {
    display: block;
    font-weight: 700;
    white-space: nowrap;
  }

  .sub {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--mut);
    font-size: 0.74rem;
  }

  .sub.mono {
    font-size: 0.7rem;
  }

  .new-tag {
    padding: 0 6px;
    border-radius: 999px;
    background: var(--select);
    color: var(--bg);
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.04em;
  }

  .new-tag[hidden] {
    display: none;
  }

  .ref {
    font-size: 0.82rem;
  }

  .none {
    color: var(--faint);
  }

  .amount {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .caller {
    white-space: nowrap;
  }

  .caller > span:first-child {
    display: block;
    font-weight: 700;
  }

  .caller > .mono:first-child {
    font-size: 0.8rem;
  }

  .go {
    text-align: right;
    white-space: nowrap;
  }

  .go a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--select);
    font-size: 0.8rem;
    font-weight: 800;
    text-decoration: none;
  }

  .go a:hover {
    text-decoration: underline;
  }

  .empty td {
    padding: 22px 14px;
    color: var(--mut);
    text-align: center;
  }

  .linkish {
    margin-left: 6px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--select);
    font-weight: 800;
    cursor: pointer;
  }

  .chart-note {
    margin-top: 10px;
    color: var(--faint);
    font-size: 0.78rem;
  }

  /* Without the script, every entry's details are listed here and each row's Details link jumps to its card. */
  .store-list {
    display: grid;
    gap: 14px;
  }

  .store-card {
    padding: 20px 22px;
    scroll-margin-top: calc(var(--header-h) + 12px);
  }

  :global(html.js) .store {
    display: none;
  }

  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(560px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--stroke-strong);
    background: var(--panel-solid);
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  .drawer[open] {
    animation: slide-in 0.18s ease-out;
  }

  .drawer::backdrop {
    background: rgba(5, 7, 12, 0.55);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }

  @keyframes slide-in {
    from {
      transform: translateX(24px);
      opacity: 0;
    }
  }

  /* Fills the dialog, so a click that lands on the dialog itself can only be a click on the backdrop. */
  .drawer-in {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .drawer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--stroke);
  }

  .steps {
    display: flex;
    gap: 6px;
  }

  .dbtn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 5px 12px;
    border: 1px solid var(--stroke);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font-size: 0.8rem;
    font-weight: 800;
    cursor: pointer;
  }

  .dbtn:hover:not([disabled]) {
    color: var(--ink);
    background: var(--hover);
  }

  .dbtn[disabled] {
    opacity: 0.4;
    cursor: default;
  }

  .dbtn.sq {
    justify-content: center;
    width: 34px;
    padding: 0;
  }

  .dbtn :global(.up) {
    transform: rotate(180deg);
  }

  .drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 22px 32px;
  }

  @media (max-width: 1080px) {
    .kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .att-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .help dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }

  @media (max-width: 480px) {
    .kpis {
      grid-template-columns: minmax(0, 1fr);
    }

    .search {
      flex-basis: 100%;
    }

    .drawer-body {
      padding: 18px 16px 28px;
    }
  }
</style>
