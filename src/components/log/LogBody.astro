---
// A log screen's content, read from the log API on the server. LogScreen renders it as a server island,
// so the page shows a loader at once and this replaces it when the log has been read.
import Icon from '../Icon.astro';
import ToneIcon from '../ToneIcon.astro';
import StatusPill from '../StatusPill.astro';
import EntryDetail from './EntryDetail.astro';
import { fetchLog, logs, summarize, type LogEntry, type LogId } from '../../data/api/bill-log';
import { ago, compactPkr, duration, int, pct, pkr, pkt, pktTime, pktWhen } from '../../lib/format';

interface Props {
  log: LogId;
}

const kind = logs[Astro.props.log];
const { outcomes, one, many, anchor } = kind;

/** Keeps a long log's page light; the figures still count every entry. */
const SHOWN = 300;

const src = await fetchLog(kind);
const now = new Date();
const list = src.entries;
const sum = summarize(list);
const rows = list.slice(0, SHOWN);
const byId = Object.fromEntries(outcomes.map((o) => [o.id, o]));
// Columns appear only when the log records them: the payment log carries amounts, the inquiry log the caller.
const priced = list.some((q) => q.amount !== null);
const hasCaller = rows.some((q) => q.ip || q.client);
const cols = 5 + Number(priced) + Number(hasCaller);

const pill = src.live
  ? { tone: 'ok', text: `Live · read ${pktTime(src.fetchedAt)}`, about: `Read from ${src.url} at ${pkt(src.fetchedAt)} PKT` }
  : {
      tone: 'wait',
      text: `Log unreachable · snapshot ${pkt(src.fetchedAt, true)}`,
      about: `${src.tried} could not be read (${src.error}), so this is the snapshot of ${src.url} taken ${pkt(src.fetchedAt)} PKT`,
    };

const errorsNote = sum.errors
  .slice(0, 2)
  .map(([desc, n]) => (n > 1 ? `${desc} (${n})` : desc))
  .join(' · ');

const kpis =
  sum.total === 0
    ? []
    : [
        { label: `${kind.Many} logged`, value: int(sum.total), sub: `Since ${pktWhen(sum.oldest!, now)}` },
        priced
          ? {
              label: 'Collected',
              value: compactPkr(sum.collected),
              sub: `${int(sum.counts.returned)} of ${int(sum.total)} ${many} ${kind.okKpi.toLowerCase()} · ${pct(sum.counts.returned, sum.total, 0)}`,
            }
          : { label: kind.okKpi, value: pct(sum.counts.returned, sum.total, 0), sub: `${int(sum.counts.returned)} of ${int(sum.total)} ${many}` },
        {
          label: 'Typical reply time',
          value: sum.medianMs !== null ? duration(sum.medianMs) : '—',
          sub: sum.slowestMs !== null ? `Median · slowest ${duration(sum.slowestMs)}` : 'No replies yet',
        },
        { label: `Last ${one}`, value: ago(sum.newest!, now), sub: pktWhen(sum.newest!, now) },
      ];

const searchText = (q: LogEntry) =>
  [q.billRef, q.billId, q.id, q.amount, q.correlationId, q.requestId, q.ip, q.code, q.desc, q.sender, q.senderUser, q.receiver, q.client]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
---

<div class="page-head">
  <div>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/dashboard/">Home</a><span class="sep" aria-hidden="true">/</span><span>Monitoring</span></nav>
    <h1 class="title">{kind.title}</h1>
    <p>Source: RSOP {one} log · newest first</p>
  </div>
  <div class="head-tools">
    <span class="pill" data-tone={pill.tone} title={pill.about}>
      {pill.text}
      <span class="sr-only">: {pill.about}</span>
    </span>
    <a class="btn" href="" data-refresh><Icon name="retry" size={16} />Refresh</a>
  </div>
</div>

{
  sum.total === 0 ? (
    <section class="state glass" aria-labelledby="empty-h" data-tone="info">
      <ToneIcon tone="info" ring />
      <div class="state-body">
        <h2 id="empty-h">No {many} logged yet</h2>
        <p class="muted">The log answered with an empty list at {pktTime(src.fetchedAt)} PKT. Refresh after the next bill {one}.</p>
      </div>
    </section>
  ) : (
    <>
      <section aria-labelledby="sum-h">
        <h2 id="sum-h" class="sr-only">Summary</h2>
        <div class="kpis">
          {kpis.map((k) => (
            <div class="kpi glass">
              <p class="kpi-label">{k.label}</p>
              <p class="kpi-value">{k.value}</p>
              <p class="kpi-sub">{k.sub}</p>
            </div>
          ))}
        </div>

        <div class="attention" role="group" aria-label="Needs attention">
          {sum.counts.silent || sum.counts.error ? (
            <>
              {sum.counts.silent > 0 && (
                <div class="strip" data-tone="wait">
                  <ToneIcon tone="wait" ring />
                  <p>
                    <b>{int(sum.counts.silent)} no reply</b>
                    <span class="strip-note">Logged, but no reply was recorded</span>
                  </p>
                  <a class="strip-link" href="?show=silent#log">
                    Show in log
                  </a>
                </div>
              )}
              {sum.counts.error > 0 && (
                <div class="strip" data-tone="fail">
                  <ToneIcon tone="fail" ring />
                  <p>
                    <b>
                      {int(sum.counts.error)} {sum.counts.error === 1 ? 'error reply' : 'error replies'}
                    </b>
                    <span class="strip-note">{errorsNote}</span>
                  </p>
                  <a class="strip-link" href="?show=error#log">
                    Show in log
                  </a>
                </div>
              )}
            </>
          ) : (
            <div class="strip" data-tone="ok">
              <ToneIcon tone="ok" ring />
              <p>Nothing needs attention: every {one} came back SUCCESS</p>
            </div>
          )}
        </div>
      </section>

      <section class="log" id="log" aria-labelledby="log-h" data-log data-anchor={anchor} data-many={many} data-seen-key={`rsop-${many}-seen`}>
        <div class="tcard glass">
          <div class="tbar">
            <div class="tbar-title">
              <h2 id="log-h">
                {kind.Many} <span class="tcount">({int(sum.total)})</span>
              </h2>
              <p class="tsub">
                <span title={`Select ${kind.aOne} for its IDs, participants and headers`}>Newest first · Pakistan time (PKT)</span>
                <span class="new-note" data-new-note hidden></span>
              </p>
            </div>

            <div class="tbar-tools">
              <label class="search">
                <Icon name="search" size={16} />
                <span class="sr-only">Search {many}</span>
                <input class="input" type="search" placeholder="Bill reference, ID, participant or IP" autocomplete="off" data-search />
              </label>
              <div class="chips" role="group" aria-label={`Show ${many} by result`}>
                <button class="chip" type="button" data-show="all" aria-pressed="true">
                  All <span class="count">{int(sum.total)}</span>
                </button>
                {outcomes.map((o) => (
                  <button class="chip" type="button" data-show={o.id} data-tone={o.tone} aria-pressed="false">
                    <ToneIcon tone={o.tone} ring />
                    {o.label}
                    <span class="count">{int(sum.counts[o.id])}</span>
                  </button>
                ))}
              </div>
              <details class="legend">
                <summary title="What each result means">
                  <Icon name="info" size={16} />
                  Legend
                </summary>
                <div class="legend-pop">
                  <p class="legend-h">Results</p>
                  <dl>
                    {outcomes.map((o) => (
                      <div>
                        <dt>
                          <StatusPill tone={o.tone} word={o.label} />
                        </dt>
                        <dd>{o.means}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </details>
            </div>
          </div>

          <p class="sr-only" aria-live="polite" data-log-status></p>

          <div class="table-wrap">
            <table class="table log-table">
              <caption class="sr-only">{kind.title}, newest first</caption>
              <thead>
                <tr>
                  <th scope="col">Time (PKT)</th>
                  <th scope="col">Bill reference</th>
                  {priced && (
                    <th scope="col" class="num">
                      Amount
                    </th>
                  )}
                  <th scope="col">Result</th>
                  <th scope="col" class="num">
                    Reply time
                  </th>
                  {hasCaller && <th scope="col">Called from</th>}
                  <th scope="col" class="go">
                    <span class="sr-only">Details</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {rows.map((q) => (
                  <tr data-row data-id={q.id} data-at={q.at} data-show={q.outcome} data-text={searchText(q)}>
                    <td class="when">
                      <time datetime={q.at}>{pktWhen(q.at, now)}</time>
                      <span class="sub">
                        {ago(q.at, now)}
                        <span class="new-tag pill" data-tone="info" data-new hidden>
                          New
                        </span>
                      </span>
                    </td>
                    <td class="ref mono">{q.billRef ?? <span class="none">none</span>}</td>
                    {priced && <td class="num amount">{q.amount !== null ? pkr(q.amount) : <span class="none">—</span>}</td>}
                    <td class="result">
                      <StatusPill
                        tone={byId[q.outcome].tone}
                        code={q.outcome === 'error' ? (q.code ?? undefined) : undefined}
                        word={q.outcome === 'error' ? q.desc || byId.error.label : byId[q.outcome].label}
                      />
                    </td>
                    <td class="num">{q.replyMs !== null ? duration(q.replyMs) : <span class="none">—</span>}</td>
                    {hasCaller && (
                      <td class="caller">
                        <span class:list={{ mono: !q.local }}>{q.local ? 'Same server' : (q.ip ?? '—')}</span>
                        {q.client && <span class="sub mono">{q.client}</span>}
                      </td>
                    )}
                    <td class="go">
                      <a href={`#${anchor}-${q.id}`} data-open aria-label={`Details of ${one} ${q.id}`} title="Details">
                        <Icon name="next" size={16} />
                      </a>
                    </td>
                  </tr>
                ))}
                <tr class="empty" data-empty hidden>
                  <td colspan={cols}>
                    No {many} match.
                    <button class="linkish" type="button" data-clear>
                      Show all
                    </button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          {/* Ten rows a page, over whatever the chips and search let through; bill-log.ts fills and drives it. */}
          <nav class="pager" aria-label={`${kind.Many} pages`} data-pager hidden>
            <p class="pager-sum" aria-live="polite" data-pager-sum></p>
            <div class="pager-btns">
              <button class="pbtn pager-step" type="button" data-page-step="-1" aria-label="Previous page">
                <Icon name="prev" size={16} />
                Previous
              </button>
              <span class="pager-pages" data-pager-pages></span>
              <button class="pbtn pager-step" type="button" data-page-step="1" aria-label="Next page">
                Next
                <Icon name="next" size={16} />
              </button>
            </div>
          </nav>
        </div>
        {list.length > SHOWN && (
          <p class="chart-note">
            Showing the newest {int(SHOWN)} of {int(list.length)}; the figures above count all of them.
          </p>
        )}
      </section>

      <section class="store" aria-labelledby="store-h" data-store>
        <div class="section-head">
          <h2 id="store-h">{kind.One} details</h2>
        </div>
        <div class="store-list">
          {rows.map((q) => (
            <div class="store-card glass">
              <EntryDetail q={q} kind={kind} now={now} readAt={src.fetchedAt} shared={q.requestId ? (sum.requestIds.get(q.requestId) ?? 1) : 1} />
            </div>
          ))}
        </div>
      </section>

      <dialog class="drawer" aria-label={`${kind.One} details`} data-drawer>
        <div class="drawer-in">
          <div class="drawer-bar">
            <div class="steps" role="group" aria-label="Move through the log">
              <button class="dbtn" type="button" data-step="-1">
                <Icon name="chevron" size={16} class="up" />
                Newer
              </button>
              <button class="dbtn" type="button" data-step="1">
                <Icon name="chevron" size={16} />
                Older
              </button>
            </div>
            <button class="dbtn sq" type="button" data-close aria-label="Close details" title="Close">
              <Icon name="x" size={16} />
            </button>
          </div>
          <div class="drawer-body" data-drawer-body />
          <p class="sr-only" aria-live="polite" data-copy-status />
        </div>
      </dialog>
    </>
  )
}

<style>
  .head-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  /* Empty log: a plain card with a status icon, title and one line. */
  .state {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 20px 24px;
    color: var(--info-ink);
  }

  .state > :global(.tone-icon) {
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
  }

  .state-body {
    display: grid;
    gap: 4px;
    min-width: 0;
    color: var(--ink);
  }

  .state-body h2 {
    color: var(--ink-2);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5rem;
  }

  /* KPI tiles: muted label, large figure, short subtitle. */
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .kpi {
    display: grid;
    align-content: start;
    gap: 2px;
    min-width: 0;
    padding: 16px 20px;
  }

  .kpi-label {
    color: var(--mut);
    font-size: 0.875rem;
  }

  .kpi-value {
    margin-top: 4px;
    color: var(--ink-2);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kpi-sub {
    color: var(--mut);
    font-size: 0.75rem;
  }

  /* Message strips: tinted bar, semantic icon, text, one link. */
  .attention {
    display: grid;
    gap: 8px;
    margin-top: 16px;
  }

  .strip {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 8px 16px;
    border: 1px solid var(--tone-line);
    border-radius: var(--radius-sm);
    background: var(--tone-bg);
    color: var(--ink);
  }

  .strip[data-tone='ok'] {
    --tone-bg: var(--ok-bg);
    --tone-ink: var(--ok-ink);
    --tone-line: color-mix(in srgb, var(--ok) 45%, transparent);
  }

  .strip[data-tone='fail'] {
    --tone-bg: var(--fail-bg);
    --tone-ink: var(--fail-ink);
    --tone-line: color-mix(in srgb, var(--fail) 45%, transparent);
  }

  .strip[data-tone='wait'] {
    --tone-bg: var(--wait-bg);
    --tone-ink: var(--wait-ink);
    --tone-line: color-mix(in srgb, var(--wait) 45%, transparent);
  }

  .strip > :global(.tone-icon) {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    color: var(--tone-ink);
  }

  .strip p {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    min-width: 0;
  }

  .strip b {
    font-weight: 700;
  }

  .strip-note {
    color: var(--ink-2);
  }

  .strip-link {
    flex: 0 0 auto;
    margin-left: auto;
    color: var(--link);
    text-decoration: none;
    white-space: nowrap;
  }

  .strip-link:hover {
    text-decoration: underline;
  }

  /* The log: one card with a toolbar over a responsive table. */
  .log {
    margin-top: 24px;
    scroll-margin-top: calc(var(--header-h) + 12px);
  }

  .tbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 16px 16px 12px;
  }

  .tbar-title {
    flex: 1 1 220px;
    min-width: 0;
  }

  .tbar-title h2 {
    color: var(--ink-2);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5rem;
  }

  .tcount {
    font-weight: 400;
  }

  .tsub {
    color: var(--mut);
    font-size: 0.875rem;
  }

  .new-note {
    margin-left: 6px;
    color: var(--info-ink);
    font-weight: 600;
  }

  .new-note::before {
    content: '· ';
    color: var(--mut);
    font-weight: 400;
  }

  .tbar-tools {
    display: flex;
    flex: 0 1 auto;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    gap: 8px 12px;
  }

  .search {
    position: relative;
    flex: 0 1 auto;
    width: 280px;
    min-width: 200px;
  }

  .search :global(.icon) {
    position: absolute;
    top: 50%;
    left: 10px;
    color: var(--mut);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .search .input {
    padding-left: 34px;
    border-radius: var(--radius-field);
  }

  .chip[data-tone='ok'] {
    --tone-ink: var(--ok-ink);
  }

  .chip[data-tone='fail'] {
    --tone-ink: var(--fail-ink);
  }

  .chip[data-tone='wait'] {
    --tone-ink: var(--wait-ink);
  }

  .chip :global(.tone-icon) {
    width: 16px;
    height: 16px;
    color: var(--tone-ink);
  }

  /* Legend: a transparent toolbar button that opens a popover. */
  .legend {
    position: relative;
  }

  .legend summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 10px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--link);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .legend summary::-webkit-details-marker {
    display: none;
  }

  .legend summary:hover,
  .legend[open] summary {
    background: var(--hover);
  }

  .legend-pop {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    z-index: 20;
    width: min(440px, calc(100vw - 32px));
    padding: 12px 16px 14px;
    border-radius: var(--radius-sm);
    background: var(--panel-solid);
    box-shadow: var(--shadow);
  }

  .legend-h {
    margin-bottom: 8px;
    color: var(--ink-2);
    font-weight: 700;
  }

  .legend dl {
    display: grid;
    gap: 8px;
  }

  .legend dl > div {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    align-items: start;
    gap: 12px;
  }

  .legend dd {
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  /* The table sits flush inside the card, so the shared table card styling is turned off here. */
  .tcard .table-wrap {
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .log-table {
    min-width: 860px;
  }

  .log-table thead th {
    border-top: 1px solid var(--stroke);
  }

  .log-table tbody tr[data-row] {
    cursor: pointer;
  }

  .log-table tbody tr[data-current] td {
    background: var(--selected);
  }

  .log-table tbody tr[data-current] td:first-child {
    box-shadow: inset 3px 0 0 var(--link);
  }

  .log-table td.num,
  .ref {
    white-space: nowrap;
  }

  .when time {
    display: block;
    color: var(--ink);
    white-space: nowrap;
  }

  .sub {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--mut);
    font-size: 0.75rem;
  }

  .new-tag {
    line-height: 1.2;
  }

  .new-tag[hidden] {
    display: none;
  }

  .ref {
    font-size: 0.8125rem;
  }

  .none {
    color: var(--mut);
  }

  .amount {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .result {
    max-width: 320px;
  }

  .caller {
    white-space: nowrap;
  }

  .caller > span:first-child {
    display: block;
  }

  .caller > .mono:first-child {
    font-size: 0.8125rem;
  }

  .go {
    width: 48px;
    text-align: right;
  }

  .go a {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    color: var(--mut);
  }

  .go a:hover {
    color: var(--link);
    background: var(--hover);
  }

  .empty td {
    padding: 24px 16px;
    color: var(--mut);
    text-align: center;
  }

  .linkish {
    margin-left: 6px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--link);
    font-weight: 600;
    cursor: pointer;
  }

  .linkish:hover {
    text-decoration: underline;
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 8px 16px;
    border-top: 1px solid var(--stroke);
  }

  .pager[hidden] {
    display: none;
  }

  .pager-sum {
    color: var(--mut);
    font-size: 0.875rem;
  }

  .pager-btns,
  .pager-pages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }

  /* Pager buttons are transparent; the current page takes the selected state. */
  .pbtn,
  .pager-pages :global(.pbtn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 36px;
    min-height: 36px;
    padding: 0 8px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--link);
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  .pbtn:hover:not(:disabled),
  .pager-pages :global(.pbtn:hover) {
    background: var(--hover);
  }

  .pager-pages :global(.pbtn[aria-current='page']) {
    border-color: var(--link);
    background: var(--selected);
  }

  .pager-pages :global(.gap) {
    padding: 0 2px;
    color: var(--mut);
  }

  .pbtn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .chart-note {
    margin-top: 8px;
    color: var(--mut);
    font-size: 0.75rem;
  }

  /* Without the script, every entry's details are listed here and each row's Details link jumps to its card. */
  .store-list {
    display: grid;
