---
// One log screen, for bill inquiries or bill payments. The page arrives at once with a loader; the log is read
// on the server meanwhile (the API fails CORS) and its results replace the loader when they come.
import App from '../../layouts/App.astro';
import Loading from '../Loading.astro';
import LogBody from './LogBody.astro';
import { logs, type LogId } from '../../data/api/bill-log';

interface Props {
  log: LogId;
}

const kind = logs[Astro.props.log];
---

<App title={kind.title} description={`Bill ${kind.one} log, read live from RSOP, with each reply. Back-office admins.`}>
  <LogBody server:defer log={kind.id}>
    <Loading
      slot="fallback"
      admin
      title={kind.title}
      lede={`Source: RSOP ${kind.one} log · newest first`}
      reading={`the bill ${kind.one} log`}
    />
  </LogBody>
</App>

<script>
  import '../../scripts/bill-log';
</script>
