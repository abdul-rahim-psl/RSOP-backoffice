---
import Icon, { type IconName } from '../Icon.astro';
import YamlBlock from './YamlBlock.astro';
import type { Flow, NodeKind } from '../../lib/flow';

interface Props {
  flow: Flow;
  defaultNode: string;
}

const { flow, defaultNode } = Astro.props;

const icons: Record<NodeKind, IconName> = {
  start: 'flag',
  end: 'flag',
  party: 'raast',
  channel: 'users',
  inbound: 'inbound',
  notify: 'mail',
  wsi: 'wsi',
  queue: 'queue',
  rest: 'rest',
  saf: 'retry',
  store: 'store',
  biller: 'biller',
  reject: 'reject',
  service: 'more',
};
const on = (id: string) => (id === defaultNode ? '' : undefined);
/** Systems outside RSOP (Raast, the channel, billers, core banking) show only their description. */
const aboutOnly = (n: Flow['nodes'][number]) => n.kind === 'party' || n.kind === 'channel' || n.kind === 'biller';
---

<aside class="inspector" id="inspector" aria-labelledby="insp-h">
  <h2 class="sr-only" id="insp-h">Step details</h2>

  {
    flow.nodes.map((n) => (
      <header class="insp-head" data-node={n.id} data-on={on(n.id)}>
        <span class="kind-chip" data-family={n.family}>
          <Icon name={icons[n.kind]} size={20} />
        </span>
        <div class="insp-name">
          <h3>{n.label}</h3>
          {n.sub && <p class:list={{ mono: !!n.service }}>{n.sub}</p>}
        </div>
      </header>
    ))
  }

  <div class="panel">
    {
      flow.nodes.map((n) => (
        <section class="insp-sec" data-node={n.id} data-on={on(n.id)}>
          <h3 class="nojs-only">{n.label}</h3>
          <p class="about">{n.about}</p>
          {!aboutOnly(n) && n.params !== null && (
            <>
              <h4 class="fg-title">Parameters</h4>
              <YamlBlock value={n.params} label={`${n.label} parameters`} copy />
            </>
          )}
        </section>
      ))
    }
  </div>
</aside>
