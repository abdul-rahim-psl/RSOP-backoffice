---
import '../../styles/designer.css';
import Rail from './Rail.astro';
import Canvas from './Canvas.astro';
import Timeline from './Timeline.astro';
import Inspector from './Inspector.astro';
import type { Flow } from '../../lib/flow';

interface Props {
  flow: Flow;
  /** Every flow, from the same API answer as this one. */
  flows: Flow[];
}

const { flow, flows } = Astro.props;

/** The WSI carries the sketch's "YML T…", so the inspector opens on it. */
const defaultNode = flow.nodes.find((n) => n.service === 'web-service-interface')?.id ?? flow.nodes[0].id;
const defaultTxn = 1;

// Only what the script needs to switch state; everything visible is already rendered.
const client = {
  id: flow.id,
  nodes: flow.nodes.map((n) => ({ id: n.id, label: n.label })),
  edges: flow.edges,
  txns: flow.txns.map((t) => ({
    n: t.n,
    events: t.events.map((e) => ({ at: e.at, node: e.node, tone: e.tone, title: e.title, text: e.text })),
  })),
};
const json = JSON.stringify(client).replace(/</g, '\\u003c');
---

<div class="designer" data-designer data-default-node={defaultNode} data-default-txn={defaultTxn}>
  <Rail flow={flow} flows={flows} />
  <div class="dz-main">
    <Canvas flow={flow} />
    <Timeline flow={flow} defaultTxn={defaultTxn} />
  </div>
  <Inspector flow={flow} defaultNode={defaultNode} />
  <script type="application/json" data-flow set:html={json} />
</div>

<script>
  import '../../scripts/designer';
</script>
