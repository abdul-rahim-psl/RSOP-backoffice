---
import Icon, { type IconName } from '../Icon.astro';
import ToneIcon from '../ToneIcon.astro';
import { GRID, layout, type Flow, type NodeKind } from '../../lib/flow';

interface Props {
  flow: Flow;
}

const { flow } = Astro.props;
const scene = layout(flow);

const icons: Record<NodeKind, IconName | null> = {
  start: null,
  inbound: 'inbound',
  wsi: 'wsi',
  decision: 'decision',
  wait: 'wait',
  queue: 'queue',
  rest: 'rest',
  store: 'store',
  end: 'biller',
};

// Reading order follows the main line; the store and the refusal come right after the step they hang off.
const rowRank = { 0: 0, '-1': 1, 1: 2 } as const;
const ordered = [...scene.nodes].sort(
  (a, b) => a.node.col * 10 + rowRank[a.node.row] - (b.node.col * 10 + rowRank[b.node.row]),
);
---

<section class="canvas" aria-labelledby="canvas-h">
  <div class="toolbar">
    <div class="tb-title">
      <h2 id="canvas-h" class="tb-flow">{flow.name}</h2>
      <span class="pill" data-tone="wait">{flow.version}</span>
      <p class="tb-sum">{flow.summary}</p>
    </div>
    <div class="tb-tools">
      <button class="tool" type="button" popovertarget="legend" aria-label="Legend">
        <Icon name="legend" size={16} />
        <span class="tool-label">Legend</span>
      </button>
      <div class="zoom" role="group" aria-label="Zoom">
        <button class="tool sq" type="button" data-zoom="out" aria-label="Zoom out">
          <Icon name="zoom-out" size={16} />
        </button>
        <button class="tool zoom-val" type="button" data-zoom="fit" aria-label="Fit the flow to the view">
          <span data-zoom-label>Fit</span>
        </button>
        <button class="tool sq" type="button" data-zoom="in" aria-label="Zoom in">
          <Icon name="zoom-in" size={16} />
        </button>
      </div>
    </div>
  </div>

  <div class="viewport" data-viewport>
    <div class="stage" data-stage data-w={scene.width} data-h={scene.height} style={`--sw:${scene.width};--sh:${scene.height}`}>
      <div class="scene" style={`width:${scene.width}px;height:${scene.height}px`}>
        <svg class="edges" width={scene.width} height={scene.height} viewBox={`0 0 ${scene.width} ${scene.height}`} aria-hidden="true">
          {
            scene.edges.map((pe) => (
              <g class="edge" data-kind={pe.edge.kind} data-key={`${pe.edge.from}>${pe.edge.to}`}>
                <path class="edge-line" d={pe.d} />
                {pe.arrow && <path class="edge-arrow" d={pe.arrow} />}
                {pe.edge.label && pe.label && (
                  <text class="edge-label" x={pe.label.x} y={pe.label.y} text-anchor="middle">
                    {pe.edge.label}
                  </text>
                )}
              </g>
            ))
          }
        </svg>

        <ol class="nodes" aria-label={`${flow.name}: steps in order`}>
          {
            ordered.map(({ node, box, round }) => {
              const side = node.row === -1 ? 'right' : 'below';
              const style =
                side === 'right'
                  ? `left:${box.x}px;top:${box.y}px`
                  : `left:${box.cx - GRID.col / 2}px;top:${box.y}px;width:${GRID.col}px`;
              const icon = node.id === 'rejected' ? 'reject' : icons[node.kind];
              const edgeLabels = flow.edges.filter((e) => e.from === node.id && e.label).map((e) => e.label);
              return (
                <li>
                  <button
                    class="node"
                    type="button"
                    style={style}
                    data-node={node.id}
                    data-kind={node.kind}
                    data-family={node.family}
                    data-origin={node.origin}
                    data-side={side}
                    data-round={round ? '' : undefined}
                    data-name={`${node.label}, ${node.sub}${node.origin === 'doc' ? ', added from the doc' : ''}`}
                    aria-label={`${node.label}, ${node.sub}${node.origin === 'doc' ? ', added from the doc' : ''}`}
                    aria-pressed="false"
                    aria-controls="inspector"
                  >
                    <span class="nbox" style={`width:${box.w}px;height:${box.h}px`}>
                      {icon && <Icon name={icon} size={round ? 18 : 24} />}
                      <span class="badge" aria-hidden="true">
                        <ToneIcon tone="ok" />
                        <ToneIcon tone="fail" />
                        <ToneIcon tone="wait" />
                        <ToneIcon tone="info" />
                      </span>
                    </span>
                    <span class="ncap">
                      <span class="nlabel">{node.label}</span>
                      <span class:list={['nsub', { mono: !!node.template }]}>{node.sub}</span>
                      {edgeLabels.length > 0 && <span class="sr-only">Leads on with: {edgeLabels.join(', ')}</span>}
                    </span>
                  </button>
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<div id="legend" class="legend glass" popover>
  <p class="seclabel">Legend</p>
  <ul class="lg-list">
    <li><span class="lg-sw" data-family="raast"></span>Faces Raast</li>
    <li><span class="lg-sw" data-family="rsop"></span>RSOP’s own processing</li>
    <li><span class="lg-sw" data-family="queue"></span>Queue</li>
    <li><span class="lg-sw" data-family="outbound"></span>Outbound call</li>
    <li><span class="lg-sw" data-family="store"></span>Store</li>
    <li><span class="lg-sw" data-family="biller"></span>Government biller</li>
    <li><span class="lg-sw" data-family="reject"></span>Refusal</li>
  </ul>
  <ul class="lg-list">
    <li><span class="lg-box"></span>On KJ’s sketch</li>
    <li><span class="lg-box dashed"></span>Added from the Open Connect doc</li>
    <li><svg class="lg-line" viewBox="0 0 30 10" aria-hidden="true"><path d="M1 5H22" /><path class="ah" d="M29 5l-7-4v8z" /></svg>Flow; a label names the message</li>
    <li><svg class="lg-line" viewBox="0 0 30 10" aria-hidden="true"><path class="dot" d="M1 5H29" /></svg>Reads or writes the store</li>
  </ul>
  <p class="seclabel lg-sub">With a transaction picked</p>
  <ul class="lg-list">
    <li><span class="lg-badge" data-tone="ok"><ToneIcon tone="ok" /></span>Passed</li>
    <li><span class="lg-badge" data-tone="fail"><ToneIcon tone="fail" /></span>Failed</li>
    <li><span class="lg-badge" data-tone="wait"><ToneIcon tone="wait" /></span>Waiting</li>
    <li><span class="lg-badge todo"></span>Not reached (dimmed)</li>
    <li><span class="lg-ring"></span>The timeline’s current event</li>
  </ul>
</div>
