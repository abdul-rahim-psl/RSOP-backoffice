---
import Icon from '../Icon.astro';
import ToneIcon from '../ToneIcon.astro';
import { isRound, type Flow } from '../../lib/flow';

interface Props {
  flow: Flow;
  flows: Flow[];
}

const { flow, flows } = Astro.props;
---

<aside class="rail" aria-label="Flows and transactions">
  <h1 class="sr-only">Flow Designer</h1>

  <nav class="rail-sec" aria-labelledby="flows-h">
    <h2 class="rail-h" id="flows-h">Transaction flows <span class="rail-n">({flows.length})</span></h2>
    <ul class="flow-list">
      {
        flows.map((f) => (
          <li>
            <a class="flow-link" href={`/designer/${f.id}/`} aria-current={f.id === flow.id ? 'page' : undefined}>
              <Icon name="designer" size={16} />
              <span class="fl-name">{f.nav}</span>
              <span class="fl-meta">{f.nodes.filter((n) => !isRound(n)).length} steps</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <section class="rail-sec" aria-labelledby="txns-h">
    <h2 class="rail-h" id="txns-h">Transactions <span class="rail-n">({flow.txns.length})</span></h2>
    <p class="rail-hint">{flow.txns.length === 1 ? 'Sample run. Select to replay on the canvas' : 'Sample runs. Select one to replay on the canvas'}</p>
    <ul class="txn-list">
      {
        flow.txns.map((t) => (
          <li>
            <button class="txn" type="button" data-txn={t.n} aria-pressed="false">
              <span class="txn-n mono" aria-hidden="true">
                {t.n}
              </span>
              <span class="txn-body">
                <span class="txn-title">
                  <span class="sr-only">Transaction {t.n}: </span>
                  {t.title}
                </span>
                <span class="txn-detail">{t.detail}</span>
                <span class="txn-meta mono">
                  {t.started} · {t.ref}
                </span>
                <span class="txn-out" data-tone={t.tone}>
                  <ToneIcon tone={t.tone} />
                  {t.outcome}
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>
</aside>
