---
interface Props {
  href?: string;
  size?: 'md' | 'lg';
}

const { href = '/dashboard/', size = 'md' } = Astro.props;
---

<a class:list={['brand', size]} href={href} aria-label="RSOP Back Office: dashboard">
  <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="6" fill="var(--accent)" />
    <path d="M8 11h9.5a3.5 3.5 0 0 1 0 7H12l7 6" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="23.5" cy="11" r="1.9" fill="#fff" />
  </svg>
  <span class="word"><strong>RSOP</strong><span class="product">Back Office</span></span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    flex: 0 0 auto;
  }

  .mark {
    width: 28px;
    height: 28px;
  }

  .word {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    white-space: nowrap;
  }

  .word strong {
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .product {
    padding-left: 10px;
    border-left: 1px solid var(--stroke-strong);
    color: var(--ink);
    font-weight: 400;
  }

  .lg .mark {
    width: 34px;
    height: 34px;
  }

  .lg .word {
    font-size: 1.125rem;
  }

  @media (max-width: 420px) {
    .md .product {
      display: none;
    }
  }
</style>
