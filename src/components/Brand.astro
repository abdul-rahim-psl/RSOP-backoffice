---
interface Props {
  href?: string;
  size?: 'md' | 'lg';
}

const { href = '/dashboard/', size = 'md' } = Astro.props;
---

<a class:list={['brand', size]} href={href} aria-label="RSOP Back Office: dashboard">
  <img class="mark" src="/paysys-logo.png" width="195" height="30" alt="" />
  <span class="word"><strong>RSOP</strong><span class="product">Back Office</span></span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    flex: 0 0 auto;
  }

  /* The company wordmark, 195×30 at source; shown a little smaller so it stays sharp. */
  .mark {
    width: auto;
    height: 22px;
  }

  .word {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    white-space: nowrap;
  }

  .word strong {
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .product {
    padding-left: 10px;
    border-left: 1px solid var(--stroke-strong);
    color: var(--ink);
    font-weight: 400;
  }

  .lg .mark {
    height: 24px;
  }

  .lg .word {
    font-size: 1.125rem;
  }

  @media (max-width: 420px) {
    .md .product {
      display: none;
    }
  }
</style>
